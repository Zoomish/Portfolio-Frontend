# .env.example
# Copy to .env and fill in your values

# Public site URL (used for canonical, sitemap, Open Graph, JSON-LD)
VITE_SITE_URL=https://zoomish-portfolio.vercel.app

# SEO meta tags (optional overrides; sensible defaults are built in)
VITE_SEO_TITLE=
VITE_SEO_DESCRIPTION=
VITE_SEO_IMAGE_URL=
VITE_SEO_PERSON_NAME=
VITE_SEO_JOB_TITLE=
VITE_SEO_LOCALE=ru_RU
VITE_SEO_EMAIL=
VITE_SEO_KEYWORDS=
VITE_LINKEDIN_URL=

# Search engine ownership verification (from Google Search Console / Yandex Webmaster)
VITE_GOOGLE_SITE_VERIFICATION=
VITE_YANDEX_SITE_VERIFICATION=

# Google Analytics GA4 tag id
VITE_GA_ID=

# Hotjar tracking
VITE_HOTJAR_ID=
VITE_HOTJAR_VERSION=6
